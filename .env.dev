# Local development environment - simulates both cloud and edge sensor on localhost
# Use with: docker compose -f docker-compose.dev.yml --env-file .env.dev up

# =============================================================================
# DATABASE
# =============================================================================
MONGO_ROOT_PASSWORD=DevPassword123!
MONGODB_URI=mongodb://admin:DevPassword123!@mongodb:27017/idps_database?authSource=admin

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET=dev-secret-key-not-secure-do-not-use-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-password-123
TENANT_ID=default
API_KEY=dev-sensor-key

# =============================================================================
# SENSOR / EDGE DEVICE
# =============================================================================
DEVICE_ID=dev-sensor-01
REDIS_PASSWORD=RedisSecure123!

# =============================================================================
# LOGGING (verbose for development)
# =============================================================================
RUST_LOG=debug
LOG_LEVEL=debug

# =============================================================================
# SERVICES - all on localhost for dev
# =============================================================================
THREAT_INTEL_URL=http://threat-intel:8094
VPS_API_URL=http://api-gateway:8080
RASPI_ENDPOINT=http://edge-sensor:8080

# =============================================================================
# OPTIONAL SERVICES (disabled by default for local dev)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================================
# DETECTION SETTINGS
# =============================================================================
AUTO_BLOCK_ENABLED=false
