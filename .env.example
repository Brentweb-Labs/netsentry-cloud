# NetSentry Cloud — Environment Configuration
# Copy this file to .env and fill in the values.
# Run ./install.sh to generate secrets interactively.

# =============================================================================
# DOMAIN & ACCESS
# =============================================================================

# Your public domain for Traefik routing and TLS certificate issuance.
DOMAIN=netsentry.example.com

# IP allowlist for the operator dashboard (vps-dashboard). Only this IP can
# access the root path. Use CIDR notation, e.g. 203.0.113.42/32
ALLOWED_IP=<your-management-ip>/32

# =============================================================================
# DATABASE
# =============================================================================

# Generate with: openssl rand -hex 32
MONGO_ROOT_PASSWORD=change-me-before-deploy

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-before-deploy

# Admin account credentials (used by console-api)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy

# Tenant ID embedded in JWT for the default single-admin account.
# Leave as "default" for single-tenant or MSP-admin deployments.
TENANT_ID=default

# =============================================================================
# SENSOR CONNECTIVITY
# =============================================================================

# WireGuard tunnel address of the sensor node (collector endpoint).
# Each sensor gets a unique IP in the 10.10.0.0/24 range.
# This points to the first sensor; add more via the cloud console.
SENSOR_ENDPOINT=http://10.10.0.2:8080

# =============================================================================
# INTERNAL SERVICES
# =============================================================================

THREAT_INTEL_URL=http://threat-intel:8094

# =============================================================================
# LOGGING
# =============================================================================

RUST_LOG=info
LOG_LEVEL=info

# =============================================================================
# DETECTION SETTINGS
# =============================================================================

AUTO_BLOCK_ENABLED=false

# =============================================================================
# STRIPE BILLING (optional — leave empty to disable billing features)
# =============================================================================

# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# EMAIL ALERTING via SMTP (optional)
# =============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@netsentry.io

# =============================================================================
# SMS ALERTING via Twilio (optional)
# =============================================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
