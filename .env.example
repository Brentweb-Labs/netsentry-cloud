# NetSentry Cloud configuration. ./install.sh generates a ready-to-use .env;
# copy this file only if you prefer to configure by hand. Never commit .env.

# Public hostname (DNS A/AAAA record must point at this host; ports 80 and 443 open).
# Use "localhost" for a local trial with a self-signed certificate.
DOMAIN=cloud.example.com

# Secrets - generate each with: openssl rand -hex 32
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=

# First administrator, created on first start of console-api.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional
# Comma separated abuse.ch (or compatible) IP list URLs; "none" disables. Default: Feodo Tracker + SSLBL.
THREAT_FEED_URLS=
# Days to keep raw events and alerts.
EVENT_RETENTION_DAYS=30
RUST_LOG=info
